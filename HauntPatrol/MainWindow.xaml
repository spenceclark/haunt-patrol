<Window x:Class="HauntPatrol.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Haunt Patrol" Width="480" Height="680" MinWidth="420" MinHeight="520"
        Background="#FF1B1325" Foreground="#FFEDE6F5" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="128" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Foreground" Value="#FFEDE6F5" />
            <Setter Property="BorderBrush" Value="#FF5A3F7A" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFEDE6F5" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFEDE6F5" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="HAUNT PATROL" FontSize="22" FontWeight="Bold" Foreground="#FFFFB347" />
            <TextBlock Margin="0,2,0,0">
                <Run Text="State: " /><Run x:Name="StateText" FontWeight="Bold" Text="Stopped" />
            </TextBlock>

            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="StartButton" Content="Start Haunting" Click="OnStart" />
                <Button x:Name="StopButton" Content="Stop Haunting" Click="OnStop" />
            </WrapPanel>

            <GroupBox Header="Demo triggers">
                <WrapPanel>
                    <Button Content="Trigger Skeleton" Click="OnTriggerSkeleton" />
                    <Button Content="Trigger Cat" Click="OnTriggerCat" />
                    <Button Content="Trigger Glass Penalty" Click="OnTriggerGlass" />
                    <Button Content="Trigger Slime Penalty" Click="OnTriggerSlime" />
                </WrapPanel>
            </GroupBox>

            <GroupBox Header="Settings">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PrimaryOnly" Content="Primary only" IsChecked="True" />
                        <RadioButton x:Name="AllMonitors" Content="All monitors" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Encounter interval (average):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="IntervalBox" Width="120" SelectedIndex="3">
                            <ComboBoxItem Content="15 seconds" Tag="15" />
                            <ComboBoxItem Content="1 minute" Tag="60" />
                            <ComboBoxItem Content="3 minutes" Tag="180" />
                            <ComboBoxItem Content="5 minutes" Tag="300" />
                            <ComboBoxItem Content="10 minutes" Tag="600" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="SoundBox" Content="Sound enabled" IsChecked="True" />
                    <CheckBox x:Name="DemoBox" Content="Demo mode (deterministic positions and timing)" />
                </StackPanel>
            </GroupBox>

            <TextBlock Text="Recent events" Margin="0,12,0,4" FontWeight="Bold" />
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Content="Exit" HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnExit" />

        <ListBox x:Name="LogList" Background="#FF120C19" Foreground="#FFCFC4DC" BorderBrush="#FF5A3F7A"
                 FontFamily="Consolas" FontSize="11.5" />
    </DockPanel>
</Window>
